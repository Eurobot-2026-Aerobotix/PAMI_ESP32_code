{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "PlatformIO Build",
			"type": "shell",
			"command": "~/.platformio/penv/bin/platformio",
			"args": [
				"run"
			],
			"problemMatcher": [
				"$platformio"
			],
			"group": "build"
		},
		{
			"label": "PlatformIO Build Verbose",
			"type": "shell",
			"command": "~/.platformio/penv/bin/platformio",
			"args": [
				"run",
				"-v"
			],
			"problemMatcher": [
				"$platformio"
			],
			"group": "build"
		},
		{
			"label": "PlatformIO Build Test",
